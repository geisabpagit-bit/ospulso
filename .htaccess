# 1. Habilitar ejecución de scripts Perl/CGI (Protocolo 11.4)
Options +ExecCGI
AddHandler cgi-script .pl

# 2. Forzar codificación UTF-8
AddDefaultCharset UTF-8

# 3. Bloquear acceso a archivos de PHP
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# 4. Bloquear acceso web directo a bases de datos planas (.dat), contadores (.counter) y logs
<FilesMatch "\.(dat|counter|log|lock|bak)$">
    Require all denied
</FilesMatch>

# 5. Bloquear acceso web a scripts de mantenimiento, pruebas o temporales
<FilesMatch "^(scratch_.*|test.*|prueba.*|mock.*|hard_reset.*|fix_.*)\.(pl|py|sh|ps1)$">
    Require all denied
</FilesMatch>

# 6. Excepción para deploy.php si es necesario
<Files "deploy.php">
    Require all granted
</Files>

# 7. Silenciar 404 del favicon si no existe
<Files "favicon.ico">
    ErrorDocument 404 " "
</Files>
